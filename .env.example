# ORBIT Notes Environment Configuration
# Copy this file to .env and configure your values

# ====================
# Server Configuration
# ====================

# Server port
PORT=4000

# Node environment (development | production)
NODE_ENV=development

# JWT secret for authentication (CHANGE THIS IN PRODUCTION!)
# Generate with: openssl rand -base64 32
JWT_SECRET=change-me-in-production-use-random-string

# JWT expiry times
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Data storage path (for filesystem-based sync)
DATA_PATH=./data

# ====================
# Web App Configuration
# ====================

# API URL (for the web app to connect to the server)
VITE_API_URL=http://localhost:4000

# Enable E2EE by default (optional)
VITE_E2EE_DEFAULT=false

# ====================
# Optional: Database (if using Postgres instead of filesystem)
# ====================

# DATABASE_URL=postgresql://orbit:password@localhost:5432/orbit

# ====================
# Optional: External Storage Providers
# ====================

# AWS S3 (for S3-compatible sync)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=orbit-notes

# ====================
# Optional: Monitoring & Logging
# ====================

# Sentry DSN (for error tracking)
# SENTRY_DSN=

# Log level (debug | info | warn | error)
LOG_LEVEL=info

# ====================
# Docker Compose Overrides
# ====================

# These are used by docker-compose.yml
COMPOSE_PROJECT_NAME=orbit-notes
