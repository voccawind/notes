# Web App Environment Variables
# These are embedded at build time by Vite

# API endpoint
VITE_API_URL=http://localhost:4000

# Enable E2EE by default
VITE_E2EE_DEFAULT=false

# App version (auto-set by CI/CD)
VITE_APP_VERSION=0.1.0

# Feature flags
VITE_FEATURE_GRAPH_VIEW=true
VITE_FEATURE_DATABASE_VIEW=false
