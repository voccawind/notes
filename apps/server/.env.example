# Server Environment Variables

PORT=4000
NODE_ENV=development

# JWT configuration
JWT_SECRET=change-me-in-production
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Storage
DATA_PATH=./data

# Logging
LOG_LEVEL=info

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
